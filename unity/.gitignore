# Everything under ProjectSettings except what we pin is Unity-generated
# with sane defaults on first open; commit more of it from the Mac once the
# editor has written it.

# Editor/build temp droppings. .utmp is both the IL2CPP/Android native build
# cache directory (unity/.utmp/) and the editor's orphaned mid-save copy
# (<asset>.utmp); the bare pattern matches both, so do not narrow it.
*.utmp
*.utmp.meta
*.tmp
*.pidb
*.pidb.meta
*.mdb
*.mdb.meta
*.booproj
*.svd
*.opendb
*.VC.db
*.unityproj
*.userprefs

# IDE / OS
*.csproj
*.sln
*.suo
*.user
.vs/
.idea/
.DS_Store
crashlytics-build.properties
