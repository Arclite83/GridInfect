{
  "$comment": "Store and press media (gen-media.mjs). Every store dimension rule lives here and nowhere else: w/h in px, format png|jpg, alpha whether the file carries an alpha channel (App Store and Play icons reject one; adaptive foreground and monochrome layers need one), maxBytes the store's upload cap where it has one. compose names a function in gen-media.mjs; raw is a device or editor capture under rawDir (<device>/<n>.png) for screenshot_frame, taken with the game's bloom and tonemap on (never a style-bench shot: the bench has neither and its lit tiles clip to the old hot pink); caption is drawn in Chakra Petch at the STYLE-GUIDE type sizes scaled to the frame; install copies the output into installDir (unity) under --install.",
  "outDir": "out/store",
  "rawDir": "out/raw",
  "installDir": "../unity/Assets/_Project/Art/Icon",
  "entries": [
    { "id": "feature_graphic",    "platform": "play",     "w": 1024, "h": 500,  "format": "png", "alpha": false, "compose": "feature_graphic", "maxBytes": 15728640 },
    { "id": "icon_play", "platform": "play",     "w": 512,  "h": 512,  "format": "png", "alpha": false, "compose": "icon_main", "maxBytes": 1048576 },
    { "id": "icon_main", "platform": "appstore", "w": 1024, "h": 1024, "format": "png", "alpha": false, "compose": "icon_main", "install": "icon_1024.png" },
    { "id": "icon_fg",   "platform": "play",     "w": 432,  "h": 432,  "format": "png", "alpha": true,  "compose": "icon_fg",   "install": "icon_adaptive_fg_432.png" },
    { "id": "icon_bg",   "platform": "play",     "w": 432,  "h": 432,  "format": "png", "alpha": false, "compose": "icon_bg",   "install": "icon_adaptive_bg_432.png" },
    { "id": "icon_mono", "platform": "play",     "w": 432,  "h": 432,  "format": "png", "alpha": true,  "compose": "icon_mono", "install": "icon_adaptive_mono_432.png" },
    { "id": "banner_wide",        "platform": "press",    "w": 1920, "h": 640,  "format": "png", "alpha": false, "compose": "banner_wide" },
    { "id": "social_header",      "platform": "social",   "w": 1500, "h": 500,  "format": "png", "alpha": false, "compose": "social_header" },
    { "id": "shot_play_1",     "platform": "play",     "w": 1080, "h": 1920, "format": "png", "alpha": false, "compose": "screenshot_frame", "raw": "phone/1",  "caption": "Drop a bug.\nLight the board." },
    { "id": "shot_play_2",     "platform": "play",     "w": 1080, "h": 1920, "format": "png", "alpha": false, "compose": "screenshot_frame", "raw": "phone/2",  "caption": "Every lead is a path.\nEvery path spreads." },
    { "id": "shot_play_3",     "platform": "play",     "w": 1080, "h": 1920, "format": "png", "alpha": false, "compose": "screenshot_frame", "raw": "phone/3",  "caption": "Traps, walls, relays.\nRoute around them." },
    { "id": "shot_appstore_1", "platform": "appstore", "w": 1290, "h": 2796, "format": "png", "alpha": false, "compose": "screenshot_frame", "raw": "iphone/1", "caption": "Drop a bug.\nLight the board." },
    { "id": "shot_appstore_2", "platform": "appstore", "w": 1290, "h": 2796, "format": "png", "alpha": false, "compose": "screenshot_frame", "raw": "iphone/2", "caption": "Every lead is a path.\nEvery path spreads." },
    { "id": "shot_appstore_3", "platform": "appstore", "w": 1290, "h": 2796, "format": "png", "alpha": false, "compose": "screenshot_frame", "raw": "iphone/3", "caption": "Traps, walls, relays.\nRoute around them." }
  ]
}
