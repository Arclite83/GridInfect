# Native build output
*.o
*.a
*.so
*.dylib

# Python tooling used for spec extraction
__pycache__/
*.pyc

# .NET mirror build output (src/)
src/**/bin/
src/**/obj/

# ---------------------------------------------------------------------------
# Unity (project root: unity/). Generated state stays out; everything under
# Assets/ (including .meta files), Packages/, and ProjectSettings/ is
# committed. See docs/UNITY_SETUP.md.
# ---------------------------------------------------------------------------
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Ll]ogs/
unity/[Uu]serSettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/ExportedObj/
unity/.vs/
unity/.idea/
unity/.consulo/
unity/.gradle/

# IDE solution/project files Unity regenerates on demand
unity/*.csproj
unity/*.sln

# Transient scene the test runner drops into Assets/ mid-run
unity/Assets/InitTestScene*.unity*

# The editor's crash-recovery copy of an unsaved scene
unity/Assets/_Recovery/
unity/Assets/_Recovery.meta

# Editor/build temp droppings. Two different things share the .utmp name:
# unity/.utmp/ is the IL2CPP + Android native build cache (RelWithDebInfo/,
# tools/, hash_key.txt) the player build leaves behind, and <asset>.utmp is
# the editor's mid-save copy, orphaned in Assets/ by a crash or kill. The
# bare pattern catches both -- `*` also matches the empty string, so it
# matches the dotted directory name. Keep it bare; narrowing it to
# Assets/**/*.utmp would let the build cache back into git status. Same for
# the other generated caches below (mono/Boo era + VS).
*.utmp
*.utmp.meta
*.tmp
*.pidb
*.pidb.meta
*.mdb
*.mdb.meta
*.booproj
*.svd
*.opendb
*.VC.db
*.unityproj
*.userprefs
crashlytics-build.properties

# Unity crash/report droppings and packaged output
sysinfo.txt
*.stackdump
*.aab
*.unitypackage

# Signing keys never enter the repo: MobileBuild reads GI_KEYSTORE et al.
# from the environment (docs/UNITY_SETUP.md §8)
*.keystore
*.jks
*.p12
*.mobileprovision

# ---------------------------------------------------------------------------
# Asset policy: no heavy files in the repo, no LFS (docs/UNITY_SETUP.md).
# unity/Assets/_Local/ is a git-ignored staging area — heavy WIP and source
# art live there (or outside the repo) on each machine. Committed runtime
# assets are small exported formats (png/ogg). `git add -f` is the deliberate
# escape hatch if a listed format ever genuinely belongs in the repo.
# ---------------------------------------------------------------------------
unity/Assets/_Local/
unity/Assets/_Local.meta

# Source-art working formats (heavy; export don't commit)
*.psd
*.psb
*.xcf
*.kra
*.blend
*.blend[0-9]

# Uncompressed audio masters (commit .ogg exports instead)
*.wav

# style bench outputs (tools/style-bench/README.md)
tools/style-bench/shaders.js
tools/style-bench/*.png
tools/style-bench/glyphs/bin/
tools/style-bench/glyphs/obj/

# node deps for the style generators (grid-infect-style/package.json)
node_modules/

# icon round rasters (gen-icon-rounds.mjs --png); the sheet screenshot is the committed record
grid-infect-style/out/icon-rounds/*.png
!grid-infect-style/out/icon-rounds/sheet.png

# store and press media, and the raw device captures they frame (grid-infect-style/media.manifest.json)
grid-infect-style/out/store/
grid-infect-style/out/raw/
