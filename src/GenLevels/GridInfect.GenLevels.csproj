<!--
  Batch level generator (EXECUTION_PLAN stage 2): runs GeneratorV2 over a
  seed range and writes accepted levels as JSONL. Headless dotnet console
  over the Core mirror; never shipped. Invoke via tools/gen_levels.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GridInfect.GenLevels</AssemblyName>
    <RootNamespace>GridInfect.GenLevels</RootNamespace>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Mirror/GridInfect.Core.Mirror.csproj" />
  </ItemGroup>
</Project>
